{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2024",
    "lib": ["ES2024"],
    "outDir": "out",
    "sourceMap": false,
    "strict": true,
    "rootDir": "src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "declarationMap": false,
    "inlineSourceMap": false,
    "removeComments": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "src/test/**/*.test.ts",
    "src/test/**/*.spec.ts",
    "src/test/e2e/**",
    "src/test/setup.ts"
  ]
}
